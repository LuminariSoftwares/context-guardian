# Context Guardian configuration.
# Copy this file to .env and adjust for your setup, or export these same
# variable names directly in your shell / launch script -- .env is a
# convenience, not a requirement (python-dotenv is optional).

# Port Context Guardian itself listens on.
GUARDIAN_PORT=8786

# The OpenAI-compatible endpoint Guardian forwards to once it's decided
# whether to compact. This can be your model server directly (e.g. Ollama's
# own /v1 endpoint) or another proxy in front of it (LiteLLM, Headroom,
# etc.) -- Guardian doesn't care what's downstream as long as it speaks the
# OpenAI chat/completions shape.
GUARDIAN_UPSTREAM_URL=http://localhost:11434/v1

# Context window size, in tokens, of the model you're actually running.
# Keep this in sync with however your backend/model is really configured --
# Guardian has no way to discover this automatically.
GUARDIAN_NUM_CTX=32768

# Fraction of GUARDIAN_NUM_CTX at which Guardian triggers a compaction
# (0.0-1.0). 0.85 means "compact once the estimated conversation size
# crosses 85% of the context window."
GUARDIAN_COMPACT_THRESHOLD=0.85

# Number of most-recent messages that are always kept verbatim and never
# folded into a summary.
GUARDIAN_KEEP_RECENT_MESSAGES=8

# Token estimation is character-count based (no real tokenizer dependency),
# using this many characters per estimated token. The default (3.5) is
# conservative on purpose -- it triggers a little early rather than late.
GUARDIAN_CHARS_PER_TOKEN=3.5

# How long Guardian will wait for the upstream backend to respond, in
# seconds. Local "thinking"/reasoning models can go quiet for a long time
# before their first output token -- if you see 500 errors after a long
# pause, raise this rather than assuming something is broken.
GUARDIAN_UPSTREAM_TIMEOUT=600
GUARDIAN_UPSTREAM_CONNECT_TIMEOUT=10

# Where compaction events are logged, as JSON lines (one compaction event
# per line). Relative paths are relative to wherever you launch the script
# from.
GUARDIAN_LOG_PATH=logs/context_guardian_log.json
